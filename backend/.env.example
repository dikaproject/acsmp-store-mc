PORT=5000
NODE_ENV=development

DATABASE_URL="mysql://user:password@localhost:3306/sssmc_db"

# REQUIRED: strong random secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never use a default/guessable value — a weak secret lets anyone forge admin tokens.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# REQUIRED: 64-char hex (32 bytes) key used to encrypt RCON passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed browser origins for CORS.
# Falls back to FRONTEND_URL + localhost dev origins when empty.
CORS_ORIGINS=http://localhost:5173

# Set to true ONLY in development to bypass RCON player verification.
# Must be false/unset in production.
DUMMY_MODE=false

# RCON Configuration (env fallback; per-server configs are stored encrypted in DB)
RCON_HOST=localhost
RCON_PORT=25575
RCON_PASSWORD=

TRIPAY_MODE=sandbox
TRIPAY_API_KEY=your-tripay-api-key
TRIPAY_PRIVATE_KEY=your-tripay-private-key
TRIPAY_MERCHANT_CODE=your-merchant-code

# Third-party API keys (keep secret, never commit real values)
MINESKIN_API_KEY=
FONNTE_TOKEN=

LEADERBOARD_EXCLUDED=

MINECRAFT_PANEL_URL=https://panel.yourdomain.com
MINECRAFT_PANEL_KEY=your-pterodactyl-api-key
MINECRAFT_SERVER_ID=your-server-id
